# ============================================================================
#  Veritas Tasks — переменные окружения
#  Скопируйте файл в .env.local (для работы на компьютере) и заполните значения.
#  На Vercel те же переменные вводятся в Project → Settings → Environment Variables.
#  Подробно, по шагам — в SETUP_GUIDE.md.
# ============================================================================

# Адрес сайта без «/» в конце. На компьютере: http://localhost:3000
# На Vercel: адрес вашего сайта, например https://veritas-tasks.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → ваш проект → Project Settings → API Keys
# URL проекта (вида https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Публичный ключ «Publishable key» (начинается с sb_publishable_). Его можно показывать в браузере:
# все данные защищены правилами доступа (RLS) в базе.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Push-уведомления: ПУБЛИЧНЫЙ VAPID-ключ (как его создать — в SETUP_GUIDE.md).
# Приватный VAPID-ключ сюда НЕ пишется: он хранится только в секретах Supabase Edge Functions.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ----------------------------------------------------------------------------
#  Только для разработки и записи демо. На Vercel НЕ добавлять.
# ----------------------------------------------------------------------------

# Показать витрину дизайн-системы /design в production-сборке (для скриншотов)
# NEXT_PUBLIC_ENABLE_DESIGN_PAGE=1

# Секретный ключ Supabase («Secret key», sb_secret_...) — нужен только скриптам
# на вашем компьютере (демо-данные). НИКОГДА не добавляйте его на Vercel и не публикуйте.
# SUPABASE_SECRET_KEY=
